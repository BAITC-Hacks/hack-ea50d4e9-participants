# Copy to .env. These are local demo database credentials; change the password
# before making the application accessible beyond your computer.
APP_PORT=8000
POSTGRES_DB=careerquest
POSTGRES_USER=careerquest
POSTGRES_PASSWORD=careerquest
DEMO_MODE=true

# auto: OpenAI, then NVIDIA, then the deterministic ranking.
# openai / nvidia: only the selected provider, then deterministic ranking.
# off: deterministic ranking only. No API keys are required for local demo.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
AI_TIMEOUT_SECONDS=7.5
